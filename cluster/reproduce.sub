universe = vanilla
executable = /bin/bash
arguments = cluster/reproduce.sh $(group) $(Cluster) $(experiment_schedule:linear)
transfer_executable = False
should_transfer_files = NO

request_cpus = 4
request_memory = 24 GB
request_disk = 10 GB
request_gpus = 1
# Use the A100 nodes that ran the reference experiments.
requirements = (TARGET.GPUs >= 1) && regexp("A100", TARGET.GPUs_DeviceName, "i")

batch_name = BendFlow PyTorch $(experiment_schedule:linear)
output = reproduction/logs/$(Cluster).$(Process).out
error = reproduction/logs/$(Cluster).$(Process).err
log = reproduction/logs/$(Cluster).$(Process).log

queue group from (
    grayscale
    cifar10
)
