universe = vanilla
executable = /bin/bash
arguments = cluster/reproduce.sh $(group) $(Cluster) cosine
transfer_executable = False
should_transfer_files = NO

request_cpus = 4
request_memory = 24 GB
request_disk = 10 GB
request_gpus = 1
# A100 only: on the V100 nodes training dies at the first step with
# CUDNN_STATUS_EXECUTION_FAILED, while the A100 nodes run it fine.
# request_gpus's require_gpus matches against AvailableGPUs (GPU UUIDs), not
# device names, so the device model has to be filtered in requirements.
requirements = (TARGET.GPUs >= 1) && regexp("A100", TARGET.GPUs_DeviceName, "i")

batch_name = BendFlow reproduction cosine
output = reproduction/logs/$(Cluster).$(Process).out
error = reproduction/logs/$(Cluster).$(Process).err
log = reproduction/logs/$(Cluster).$(Process).log

queue group from (
    grayscale
    cifar10
)
